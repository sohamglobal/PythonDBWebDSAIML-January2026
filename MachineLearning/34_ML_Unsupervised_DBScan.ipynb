      "source": [
        "from sklearn.cluster import DBSCAN\n",
        "import numpy as np"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "X=np.array([\n",
        "    [5],\n",
        "    [1.5],\n",
        "    [2],\n",
        "    [1],\n",
        "    [6],\n",
        "    [5.5],\n",
        "    [5.8],\n",
        "    [13]\n",
        "])"
      ],
      "metadata": {
        "id": "tUOYdSR47w-1"
      },
      "execution_count": 8,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "db=DBSCAN(eps=1.0,min_samples=2)"
      ],
      "metadata": {
        "id": "Y9Abyy4N7_Th"
      },
      "execution_count": 9,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "labels=db.fit_predict(X)\n",
        "print(labels)"
      ],
